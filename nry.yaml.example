# Narya Runtime Engine Configuration
# Copy this file to .nry.yaml and adjust as needed.

server:
  host: 0.0.0.0
  port: 8888
  read_timeout: 60
  write_timeout: 60
  enable_http2: true
  # TCP listen backlog (default 4096)
  backlog: 4096

workers:
  # Diagnostic profile for Laravel/WSL — lower min, stagger boot
  count: 4
  min_workers: 2
  max_workers: 6
  keep_warm: true

  max_requests: 100
  timeout: 30

  # Laravel/WSL: allow slow PHP bootstrap before UDS connect
  spawn_timeout_secs: 120
  handshake_timeout_secs: 15
  max_parallel_spawns: 4
  ensure_min_debounce_ms: 500
  respawn_backoff_ms: 400
  respawn_timeout_secs: 120

  # Stagger worker spawn (ms) to avoid 16 Laravel boots at once
  warmup_stagger_ms: 300
  fast_warmup: true

  scale_down_idle_secs: 30
  aggressive_scale_down_secs: 10

  # UDS socket directory (empty = /tmp/narya). In Docker use a project path.
  # socket_dir: /var/www/bootstrap/cache/narya

  backpressure:
    enabled: true
    max_queue: 100

  queue_timeout:
    enabled: true
    timeout_ms: 1000

  # Production-stable profile (after diagnostics):
  # min_workers: 2
  # max_workers: 8
  # max_requests: 300
  # backpressure.max_queue: 500
  # queue_timeout.timeout_ms: 1500

php:
  binary: php
  worker_script: worker.php

logging:
  level: debug
  format: text
